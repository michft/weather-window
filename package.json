{
  "name": "weather-window",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server.ts",
    "start": "node --env-file-if-exists=.env server.ts --production",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
